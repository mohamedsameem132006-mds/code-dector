# Groq API Configuration (Primary Provider - Serverless / Backend only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini AI API Configuration (Fallback Provider)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=e-dector.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=e-dector
VITE_FIREBASE_STORAGE_BUCKET=e-dector.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
